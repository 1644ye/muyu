{
  "format": "muyu-style",
  "version": 1,
  "name": "柔和霓虹",
  "appearance": {
    "preset": "neon",
    "color": "#c3a6ff",
    "background": "#17112b",
    "backgroundOpacity": 1,
    "gradient": "",
    "shape": "rounded",
    "borderColor": "#b7e4ce35",
    "borderWidth": 1,
    "borderStyle": "solid",
    "radius": 18,
    "radiusX": null,
    "radiusY": null,
    "shadow": 30,
    "shadowColor": "#00000044",
    "shadowX": 0,
    "shadowY": 8,
    "blur": 0,
    "glow": 14,
    "font": null,
    "fontSize": 54,
    "fontWeight": 500,
    "lineHeight": 1.25,
    "letterSpacing": 0,
    "staleOpacity": 0.45,
    "transition": 400,
    "easing": "ease",
    "animations": true,
    "trackColor": "#ffffff18",
    "trackOpacity": 1,
    "chartWidth": 12,
    "chartHeight": 22,
    "segmentCount": 20,
    "segmentGap": 6,
    "segmentRadius": 3,
    "segmentDirection": "horizontal",
    "segmentFill": "solid",
    "animationDuration": 1800
  },
  "css": {
    "enabled": true,
    "code": ".muyu-value { font-family: Consolas, monospace; text-shadow: 0 0 18px currentColor; }"
  },
  "layout": {
    "layout": "vertical",
    "padding": 28,
    "gap": 12,
    "align": "left",
    "showIcon": true,
    "iconSize": 26,
    "showTitle": true
  }
}