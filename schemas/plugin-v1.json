{
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "ne",
            "exists",
            "empty",
            "truthy"
          ]
        },
        "value": {},
        "all": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "any": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "not": {
          "$ref": "#/$defs/condition"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "definition",
    "version",
    "sourceId",
    "field",
    "view",
    "options",
    "appearance",
    "rules",
    "mappings",
    "animations",
    "css"
  ],
  "properties": {
    "definition": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "sourceId": {
      "type": "string"
    },
    "field": {
      "type": "string",
      "maxLength": 200
