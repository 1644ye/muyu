    "view": {
      "enum": [
        "number",
        "text",
        "icon",
        "progress",
        "ring",
        "gauge",
        "line",
        "bars",
        "list",
        "table",
        "calendar",
        "analog",
        "liquid",
        "segments",
        "container"
      ]
    },
    "options": {
      "type": "object",
      "required": [
        "title",
        "label",
        "unit",
        "precision",
        "min",
        "max",
        "scale",
        "offset",
        "empty",
        "template",
        "icon",
        "showIcon",
        "iconSize",
        "layout",
        "padding",
        "gap",
        "align",
        "showStatus",
        "showTitle",
        "history",
        "timezone",
        "target",
        "format",
        "hideWhenEmpty"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "scale": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "empty": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "showIcon": {
          "type": "boolean"
        },
        "iconSize": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "layout": {
          "enum": [
            "vertical",
            "horizontal",
            "compact",
            "expanded"
          ]
        },
        "padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "showStatus": {
          "type": "boolean"
        },
        "showTitle": {
          "type": "boolean"
        },
        "history": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "timezone": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "format": {
          "enum": [
            "default",
            "countdown",
            "elapsed",
            "pomodoro"
          ]
        },
        "hideWhenEmpty": {
          "type": "boolean"
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "backgroundOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gradient": {
          "type": "string"
        },
        "shape": {
          "enum": [
            "rect",
            "rounded",
            "ellipse",
            "capsule"
          ]
        },
        "borderColor": {
          "type": "string"
        },
        "borderWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "borderStyle": {
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "double"
          ]
        },
        "radius": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "radiusX": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "radiusY": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "shadow": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "shadowColor": {
          "type": "string"
        },
        "shadowX": {
          "type": "number",
          "minimum": -2000,
          "maximum": 2000
        },
        "shadowY": {
          "type": "number",
          "minimum": -2000,
          "maximum": 2000
        },
        "blur": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "glow": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fontSize": {
          "type": "number",
          "minimum": 1,
          "maximum": 2000
        },
        "fontWeight": {
          "type": "number",
          "minimum": 100,
          "maximum": 900
        },
        "lineHeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 5
        },
        "letterSpacing": {
          "type": "number",
          "minimum": -200,
          "maximum": 200
        },
        "staleOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "transition": {
          "type": "number",
          "minimum": 0,
          "maximum": 60000
        },
        "easing": {
          "type": "string"
        },
        "animations": {
          "type": "boolean"
        },
        "trackColor": {
          "type": "string"
        },
        "trackOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "chartWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "chartHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "segmentCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "segmentGap": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "segmentRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "segmentDirection": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "segmentFill": {
          "enum": [
            "solid",
            "gradient"
          ]
        },
        "animationDuration": {
          "type": "number",
          "minimum": 100,
          "maximum": 60000
        }
      }
