    "css": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "code"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "maxLength": 100000
        }
      }
    }
  }
}