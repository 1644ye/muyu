        "properties": {
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "eq",
                  "ne",
                  "exists",
                  "empty",
                  "truthy"
                ]
              },
              "value": {},
              "all": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/condition"
                }
              },
              "any": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/condition"
                }
              },
              "not": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "set": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "color": {
                "type": "string"
              },
              "background": {
                "type": "string"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "hidden": {
                "type": "boolean"
              },
              "icon": {
                "type": "string"
              },
              "animation": {
                "enum": [
                  "none",
                  "pulse",
                  "glow"
                ]
              }
            }
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "target",
          "min",
          "max",
          "outMin",
          "outMax"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "target": {
            "enum": [
              "opacity",
              "fontSize",
              "radius",
              "blur"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "outMin": {
            "type": "number"
          },
          "outMax": {
            "type": "number"
          }
        }
      }
    },
    "animations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "keyframes",
          "duration"
        ],
        "properties": {
          "target": {
            "enum": [
              "card",
              "value",
              "icon"
            ]
          },
          "duration": {
            "type": "number",
            "minimum": 100,
            "maximum": 600000
          },
          "delay": {
            "type": "number",
            "minimum": 0,
            "maximum": 600000
          },
          "iterations": {
            "enum": [
              "infinite",
              1,
              2,
              3,
              4,
              5
            ]
          },
          "easing": {
            "type": "string"
          },
          "keyframes": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "transform": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                },
                "backgroundColor": {
                  "type": "string"
                },
                "offset": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "eq",
                  "ne",
                  "exists",
                  "empty",
                  "truthy"
                ]
              },
              "value": {},
              "all": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/condition"
                }
              },
              "any": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/condition"
                }
              },
              "not": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        }
      }
